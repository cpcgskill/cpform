[MAIN]
fail-under=8.40
[MESSAGES CONTROL]
disable=
    import-error,             # 动态依赖（maya / PyQt 等）缺失不报错
    undefined-variable,       # Q* 系列变量未定义不报错
    missing-docstring,        # 函数/类/模块缺少文档字符串
    wrong-import-position,    # import 顺序
    wildcard-import,          # 通配符 import
    consider-using-f-string,  # 建议用 f-string
    invalid-name,             # 命名风格（snake_case, PascalCase, UPPER_CASE）
    multiple-statements,      # 单行多语句
    using-constant-test,      # if True/False 这类恒真/恒假条件
    consider-using-enumerate, # 建议用 enumerate
    bad-super-call            # Py2 / Py3 参数差异导致的 super 报错

[SIMILARITIES]
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
min-similarity-lines=3
